# Telegram
# Создай бота через @BotFather и вставь токен сюда.
TELEGRAM_BOT_TOKEN=

# Безопасность. Если оставить пустым, бот ответит любому, кто знает токен бота.
# Узнать свой id можно командой /whoami после запуска.
# Пример формата: 123456789,987654321
TELEGRAM_ALLOWED_USER_IDS=

# LLM / Alice AI LLM через Yandex AI Studio OpenAI-compatible API
LLM_BASE_URL=https://llm.api.cloud.yandex.net/v1
LLM_API_KEY=
LLM_PROJECT=
YANDEX_FOLDER_ID=
LLM_MODEL=
LLM_AUTH_HEADER_MODE=api-key
LLM_TOOL_MODE=auto
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=1200
LLM_MAX_TOOL_ITERATIONS=6

# MCP-сервер покупок из предыдущего проекта
MCP_SERVER_COMMAND=/home/vityakarpenko2016/apps/purchase-tracker/.venv/bin/purchase-tracker-mcp
MCP_SERVER_ARGS=

# Та же БД, что использует MCP-сервер. Можно не указывать: MCP возьмёт свой дефолт.
PURCHASE_DB_PATH=/home/vityakarpenko2016/.purchase_tracker_mcp/purchases.sqlite3

# Настройки агента
AGENT_TIMEZONE=Europe/Moscow
AGENT_DEFAULT_CURRENCY=RUB
AGENT_HISTORY_TURNS=10
LOG_LEVEL=INFO
